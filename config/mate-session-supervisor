#!/usr/bin/python3
"""Keep MATE's descendants owned by this session and clean them up on logout."""

import ctypes
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def descendants():
    pending = [os.getpid()]
    found = set()
    while pending:
        parent = pending.pop()
        try:
            children = Path(f"/proc/{parent}/task/{parent}/children").read_text()
        except FileNotFoundError:
            continue
        for child in map(int, children.split()):
            if child not in found:
                found.add(child)
                pending.append(child)
    return found


def send_signal(pids, signum):
    for pid in pids:
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass


def reap():
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if pid == 0:
            return


def watch_logout(stop_session):
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    # Register a real session client so the timeout starts only after MATE's
    # logout confirmation/inhibitor dialogs, never on an RDP disconnect.
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    context = GLib.MainContext.default()
    client = None
    logout_deadline = None

    def respond(flags):
        client.EndSessionResponse(True, "", reply_handler=lambda: None,
                                  error_handler=lambda error: None)

    def end_session(flags):
        nonlocal logout_deadline
        logout_deadline = time.monotonic() + 10
        respond(flags)

    def cancel_session():
        nonlocal logout_deadline
        logout_deadline = None

    def poll():
        nonlocal client
        if client is None and bus.name_has_owner("org.gnome.SessionManager"):
            manager = dbus.Interface(bus.get_object(
                "org.gnome.SessionManager", "/org/gnome/SessionManager"
            ), "org.gnome.SessionManager")
            path = manager.RegisterClient("xrdp-logout-watchdog", "")
            client = dbus.Interface(bus.get_object(
                "org.gnome.SessionManager", path
            ), "org.gnome.SessionManager.ClientPrivate")
            client.connect_to_signal("QueryEndSession", respond)
            client.connect_to_signal("EndSession", end_session)
            client.connect_to_signal("CancelEndSession", cancel_session)
            client.connect_to_signal("Stop", stop_session)
        while context.pending():
            context.iteration(False)
        if logout_deadline is not None and time.monotonic() >= logout_deadline:
            print("MATE logout timed out; ending session processes.",
                  file=sys.stderr, flush=True)
            stop_session()
    return poll


def main():
    # Both the private bus and the desktop have subreapers. The outer one also
    # owns orphaned D-Bus activated services when the private bus exits.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))

    stopping = False

    def stop_session():
        nonlocal stopping
        stopping = True

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, lambda signum, frame: stop_session())

    env = os.environ.copy()
    if sys.argv[1:] == ["--session-bus"]:
        poll = watch_logout(stop_session)
        command = ["/etc/X11/Xsession"]
    else:
        poll = lambda: None
        env.pop("DBUS_SESSION_BUS_ADDRESS", None)
        env.pop("DBUS_SESSION_BUS_PID", None)
        command = ["dbus-run-session", "--", sys.executable, __file__, "--session-bus"]
    session = subprocess.Popen(command, env=env)
    try:
        while session.poll() is None and not stopping:
            poll()
            time.sleep(0.1)
    finally:
        # Give applications a bounded graceful shutdown, then remove survivors.
        deadline = time.monotonic() + 3
        while True:
            remaining = descendants()
            if not remaining:
                break
            send_signal(remaining, signal.SIGTERM)
            reap()
            if time.monotonic() >= deadline:
                break
            time.sleep(0.1)
        deadline = time.monotonic() + 1
        while descendants() and time.monotonic() < deadline:
            send_signal(descendants(), signal.SIGKILL)
            reap()
            time.sleep(0.05)
        reap()
    return session.returncode if session.returncode is not None else 0


if __name__ == "__main__":
    raise SystemExit(main())
